DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# Production (Supabase): use the "Session pooler" connection string, not
# the direct connection — Supabase's direct host is IPv6-only on the free
# tier, which most PaaS platforms (Render included) can't reach. See
# README "Deployment" for where to find it.
#
# ALLOWED_ORIGINS is optional — comma-separated list of origins to accept
# WebSocket connections from. Leave unset locally; set it in production to
# the deployed web app's domain(s), e.g.:
# ALLOWED_ORIGINS=https://your-app.vercel.app
